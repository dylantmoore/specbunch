function(sbc_stata_spi target)
  set(spi "${CMAKE_CURRENT_BINARY_DIR}/stata-spi")
  file(MAKE_DIRECTORY "${spi}")
  foreach(ext IN ITEMS c h)
    if(ext STREQUAL "c")
      set(hash ab694f53e30a404bbfbe59d301a81b8bc59eeecf84bc5427eb65cbf0c5020d6d)
    else()
      set(hash 0d32086bfb7a621e30ed7fefa41b351b6733bb4561da28a4c581580d62c64e8b)
    endif()
    file(DOWNLOAD "https://www.stata.com/plugins/stplugin.${ext}" "${spi}/stplugin.${ext}"
      EXPECTED_HASH SHA256=${hash} TLS_VERIFY ON)
  endforeach()
  target_include_directories(${target} PRIVATE "${spi}")
endfunction()
