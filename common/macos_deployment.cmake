# Include before project(): initialize compiler checks and every native target
# with the same minimum OS, rather than inheriting the builder's current OS.
include_guard(GLOBAL)
if(CMAKE_SYSTEM_NAME STREQUAL "Darwin" OR (CMAKE_HOST_APPLE AND NOT CMAKE_SYSTEM_NAME))
  set(_sbc_arch "${CMAKE_OSX_ARCHITECTURES}")
  if(NOT _sbc_arch)
    set(_sbc_arch "${CMAKE_HOST_SYSTEM_PROCESSOR}")
  endif()
  if(NOT _sbc_arch)
    # CMAKE_HOST_SYSTEM_PROCESSOR is not populated until project() on CMake 4.
    execute_process(COMMAND uname -m OUTPUT_VARIABLE _sbc_arch OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
  endif()
  if(_sbc_arch MATCHES "arm64|aarch64")
    set(_sbc_minos "11.0")
  elseif(_sbc_arch MATCHES "x86_64|AMD64")
    set(_sbc_minos "10.15")
  else()
    message(FATAL_ERROR "Specify CMAKE_OSX_ARCHITECTURES=arm64 or x86_64")
  endif()
  if(NOT CMAKE_OSX_DEPLOYMENT_TARGET)
    set(CMAKE_OSX_DEPLOYMENT_TARGET "${_sbc_minos}" CACHE STRING "Minimum supported macOS" FORCE)
  endif()
  message(STATUS "Spectral macOS deployment: ${_sbc_arch}, minimum ${CMAKE_OSX_DEPLOYMENT_TARGET}")
endif()
